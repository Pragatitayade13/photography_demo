# ==========================================
# Photography Showcase Platform Environment Config
# ==========================================

# -----------------
# Frontend Configuration
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SITE_NAME="Alex Photography"

# -----------------
# Backend Configuration
# -----------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photography_db

# Security & Session
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
SESSION_SECRET=super-secret-session-key-replace-in-production

# Supabase (Optional Object Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
